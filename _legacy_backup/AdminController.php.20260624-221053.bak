    public function selectpuesto(Request $request, $id)
    {
        $datos = $request->all();
        $puesto = puesto::find($request->id_puesto);
        $namedepto = departamento::find($puesto->id_departamento);
        userpuesto::create(['name' => $namedepto->departamento."-".$puesto->name,
        'id_puesto' => $request->id_puesto,
        'id' => $id]);
        $usuario = user::find($id);
        $usuario->puestodepartamento = $namedepto->departamento."-".$puesto->name;
        $usuario->update();
        return redirect('/usuarioscrud'); 

    }
    public function newuser(Request $request)
    {
        User::create([
            'name' => $request->name,
            'lname' => $request->lname,
            'lname2'=> $request->lname2,
            'email' => $request->email,
            'phone' => $request->phone,
            'sex' => $request->sex,
            'labn' => $request->labn,
            'zone' => $request->zone,
            'ncreditos' => $request->ncreditos,
            'borndate' => $request->borndate,
            'lastpcr' => Carbon::now(),
            'lastwr'  => Carbon::now(),
            'puestodepartamento' => $request->puestodepartamento,
            'enfermo' => 0,
            'inline' => 0,
            'tested' => 0,
            'resultpcr' => 0,
            'password' => Hash::make($request->password)
        ]);
         $subject = "Bienvenido a CrewCare";
        $data = [
            'nombre' => $request->name,
            'email' => $request->email, 
            'password' => $request->password
        ];
        $for = $request->email;
        Mail::send('correos.welcomeuser',$data, function($msj) use($subject,$for){
            $msj->from("noreply@crewcare.mx","CrewCare");
            $msj->subject($subject);
            $msj->to($for);
           // $msj->attach('https://crewcare.tech/img/PP_ProtocoloCOVID_V3_010223_CC.pdf'); // se debe proporcionar la ruta al archivo PDF

        });
        return view('admin.newuser'); 
    }
