    public function searchlab($valor)
    {
        $diatest = DB::table('testqueue')->find(1);
        switch ($diatest->mainday) {
            
            case ("3"):
                if ($valor === "vacio") {
                    $usuarios = DB::table('users')->where('activo','=',1)->where('daytest','=',3)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                            ->orderBy('users.id', 'desc')->paginate(50);

                }else{
                    $usuarios = DB::table('users')
                    ->where('users.name','LIKE','%' . $valor . '%')->where('activo','=',1)->where('daytest','=',3)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                    ->Orwhere('users.lname','LIKE','%' . $valor . '%')->where('activo','=',1)->where('daytest','=',3)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                    ->Orwhere('users.labn','LIKE','%' . $valor . '%')->where('activo','=',1)->where('daytest','=',3)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                    ->orderBy('id', 'desc')
                    ->paginate(50); 
                }

                return view("componentes.searchlab",compact('usuarios'));
                break;
            case ("2"):
            if ($valor === "vacio") {
                $usuarios = DB::table('users')->where('activo','=',1)->where('daytest','=',2)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                        ->orderBy('users.id', 'desc')->paginate(50);

            }else{
                $usuarios = DB::table('users')
                ->where('users.name','LIKE','%' . $valor . '%')->where('activo','=',1)->where('daytest','=',2)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                ->Orwhere('users.lname','LIKE','%' . $valor . '%')->where('activo','=',1)->where('daytest','=',2)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                ->Orwhere('users.labn','LIKE','%' . $valor . '%')->where('activo','=',1)->where('daytest','=',2)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                ->orderBy('id', 'desc')
                ->paginate(50); 
            }

            return view("componentes.searchlab",compact('usuarios'));
            break;
        default:
        if ($valor === "vacio") {
            $usuarios = DB::table('users')->where('activo','=',1)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
                    ->orderBy('users.id', 'desc')->paginate(50);

        }else{
            $usuarios = DB::table('users')
            ->where('users.name','LIKE','%' . $valor . '%')->where('activo','=',1)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
            ->Orwhere('users.lname','LIKE','%' . $valor . '%')->where('activo','=',1)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
            ->Orwhere('users.labn','LIKE','%' . $valor . '%')->where('activo','=',1)->where('inline','=',0)->where('tested','=',1)->where('resultpcr','=',0)
            ->orderBy('id', 'desc')
            ->paginate(50); 
        }

        return view("componentes.searchlab",compact('usuarios'));

        }
    }

    public function temperature(Request $request,$id)
