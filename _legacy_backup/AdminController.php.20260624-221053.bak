public function negativepcr()
    {
                    
        $notificaciones = User::where('activo','=',1)->where('tested','=',1)->where('resultpcr','=',0)->get();
        $subject = "TEST RESULT";
        foreach ($notificaciones as $value) {
            $data = [
                'nombre' => $value->name,
            ];
            $for = $value->email;
            Mail::send('correos.negative',$data, function($msj) use($subject,$for){
                $msj->from("noreply@crewcare.mx","CrewCare");
                $msj->subject($subject);
                $msj->to($for);
            });
        }
        
        $users = DB::table('users')->where('activo','=',1)->where('resultpcr','=',0)->where('tested','=',1)->get();
        foreach ($users as $user) {
            $producto = user::find($user->id);
            $producto->enfermo=0;
            $producto->resultpcr=1;
            $producto->inline=0;
            $producto->tested=0;
            $producto->lastpcr = Carbon::now();
            $producto->update();
            
            $prueba = prueba::create([
                'resultado' => 0
            ]);
            $pruebaform = usuariopcr::create([
                'id_usrio' => $producto->id,
                'id_prueba' => $prueba->id_prueba
            ]);

        }
            return redirect('/lab');
    }
    
//negativo end


public function negativeantg()
    {
        $notificaciones = User::where('activo','=',1)->where('tested','=',1)->where('resultpcr','=',0)->get();
        $subject = "TEST RESULT";
        foreach ($notificaciones as $value) {
           $data = [
                'nombre' => $value->name,
            ];
            $for = $value->email;
            Mail::send('correos.negative',$data, function($msj) use($subject,$for){
                $msj->from("noreply@crewcare.mx","CrewCare");
                $msj->subject($subject);
                $msj->to($for);
            });
        }

        $public_folder = public_path().'/results/';
        $date = date('d-m-Y');
        
        $users = DB::table('users')->where('activo','=',1)->where('resultpcr','=',0)->where('tested','=',1)->get();
        foreach ($users as $user) {
            $nombre = $user->name;
        $producto = user::find($user->id);
            $pdf_name = $user->name.'_'.$date.'.pdf';
            $pdf = new Dompdf();
            $pdf->loadHtml(view('correos/negativean', compact('nombre'))->render());
            $pdf->render();
            $pdf->save($public_folder.$pdf_name);
        }

        
        $users = DB::table('users')->where('activo','=',1)->where('resultpcr','=',0)->where('tested','=',1)->get();
        foreach ($users as $user) {
            $producto = user::find($user->id);
            $producto->enfermo=0;
            $producto->resultpcr=1;
            $producto->inline=0;
            $producto->tested=0;
            $producto->lastpcr = Carbon::now();
            $producto->update();
            
            $prueba = prueba::create([
                'resultado' => 0
            ]);
            $pruebaform = usuariopcr::create([
                'id_usrio' => $producto->id,
                'id_prueba' => $prueba->id_prueba
            ]);
        }
       
        return redirect('/lab');
    }
    
//negativo antigenos end


    public function pcrcrud($id)
    {
        $userpcr = DB::table('pcr')
        ->where('id','=',$id)
        ->orderBy('id_pcr', 'desc')
        ->paginate(12);
        return view("admin.pcrcrud",compact('userpcr','id'));
    }
    public function crearpcr(Request $request,$id)
    {
        $pcr = pcr::create([
            'estado' => $request->estado,
            'id' => $id
        ]);
        $user = user::find($id);
        $user->lastpcr = $pcr->created_at;
        if ($request->estado) {
            $user->enfermo = 0;
        }else{
            $user->enfermo = 1;
        }
        $user->update();
        return redirect('/usuarioscrud'); 
    }
    public function editarpcr($id)
    {
        $userpcr = pcr::find($id);
        return view("admin.pcredit",compact('userpcr'));
    }
    public function savepcr(Request $request,$id)
    {
        $pcr = pcr::find($id);
        $pcr->estado = $request->estado;
        $pcr->update();
        $user = user::find($pcr->id);
        $user->lastpcr = $pcr->created_at;
        if ($request->estado) {
            $user->enfermo = 0;
        }else{
            $user->enfermo = 1;
        }
        $user->update();
        return redirect('/usuarioscrud');
    }
    public function eliminarpcr(Request $request,$id)
    {
        $pcr = pcr::find($id);
        pcr::where('id_pcr',$id)->delete();
        $user = User::find($pcr->id);
        return redirect()->route('pcrcrud', ['id' => $user->id]);
    }
    public function sendreminder()
    {
        $notificaciones = User::where('activo','=', 1)->where('encuestadiaria','=',0)->get();
        $subject = "DAILY REPORT";
        foreach ($notificaciones as $value) {
            $data = [
                'nombre' => $value->name,
            ];
            $for = $value->email;
            Mail::send('correos.recordatorio',$data, function($msj) use($subject,$for){
                $msj->from("noreply@crewcare.mx","DAILY REPORT");
                $msj->subject($subject);
                $msj->to($for);
            });
        }
        return redirect('/home');
    }


   

    public function exportCsv()
    {
       
        $dia = Carbon::now()->subDays(45)->format('Y-m-d');
        $tasks = DB::table('userform')
        ->join('users','users.id','userform.id_usuario')
        ->whereDate('userform.created_at', '=', $dia)->get();
        $fileName = 'tasks.csv';
        $headers = array(
            "Content-type"        => "text/csv",
            "Content-Disposition" => "attachment; filename=$fileName",
            "Pragma"              => "no-cache",
            "Cache-Control"       => "must-revalidate, post-check=0, pre-check=0",
            "Expires"             => "0"
        );

        $columns = array('USUARIO', 'FECHA');

        $callback = function() use($tasks, $columns) {
            $file = fopen('php://output', 'w');
            fputcsv($file, $columns);

            foreach ($tasks as $task) {
                $row['USUARIO']  = $task->name;
                $row['FECHA']    = $task->lastwr;
                    

                fputcsv($file, array($row['USUARIO'], $row['FECHA']));
            }

            fclose($file);
        };

        return response()->stream($callback, 200, $headers);
    }

    public function expCsv()
    {
       
        $dias = Carbon::now()->subDays(0)->format('Y-m-d');
        $nowr = DB::table('userform')
        ->join('users','users.id','userform.id_usuario')
        ->whereDate('userform.created_at', '=', $dias)->get();
        $fileName = 'tasks.csv';
        $headers = array(
            "Content-type"        => "text/csv",
            "Content-Disposition" => "attachment; filename=$fileName",
            "Pragma"              => "no-cache",
            "Cache-Control"       => "must-revalidate, post-check=0, pre-check=0",
            "Expires"             => "0"
        );

        $columns = array('USUARIO', 'FECHA');

        $callback = function() use($nowr, $columns) {
            $file = fopen('php://output', 'w');
            fputcsv($file, $columns);

            foreach ($nowr as $nowr) {
                $row['USUARIO']  = $nowr->name;
                $row['FECHA']    = $nowr->lastwr;
                $row['EMAIL']    = $nowr->email;
                    

                fputcsv($file, array($row['USUARIO'], $row['FECHA'], $row['EMAIL']));
            }

            fclose($file);
        };

        return response()->stream($callback, 200, $headers);
    }
}
