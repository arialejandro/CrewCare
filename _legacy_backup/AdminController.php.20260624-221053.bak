    public function historial($id)
    {
        $usuarios = DB::table('usuariopcr') 
        ->join('prueba', 'prueba.id_prueba', '=', 'usuariopcr.id_prueba')
        ->where('usuariopcr.id_usrio','=',$id)
        ->whereDate('usuariopcr.created_at', '>', Carbon::now()->subDays(90)->format('Y-m-d'))
        ->orderBy('usuariopcr.id_prueba', 'desc')
        ->paginate(20);
        return view("componentes.historia",compact('usuarios'));
    }

    public function historialWR($id)
    {
        // Obtener un solo registro del formulario del usuario
        $datos = DB::table('formularios')
            ->join('users', 'formularios.id_user', '=', 'users.id')
            ->where('formularios.id_user', '=', $id)
            ->first();
    
        // Obtener todos los formularios del usuario
        $usuario = DB::table('formularios')
            ->where('formularios.id_user', '=', $id)
            ->get();
    
        // Obtener las consultas médicas solo del usuario actual
        $consultas = DB::table('cmedic')
            ->join('users', 'cmedic.id_user', '=', 'users.id')
            ->where('cmedic.id_user', '=', $id)
            ->orderBy('cmedic.created_at', 'desc')
            ->select('cmedic.*') // 👈 importante: evita conflictos de campos
            ->get()
            ->map(function ($consulta) {
                $consulta->created_at = Carbon::parse($consulta->created_at); // 👈 para poder usar ->format() en Blade
                return $consulta;
            });
    
        return view("componentes.historiamr", compact('usuario', 'datos', 'consultas'));
    }

    public function searchusers($valor)
    {
        if ($valor === "vacio") {
            $usuarios = DB::table('users')
            ->orderBy('users.id', 'desc')->paginate(50);

        }else{
            $usuarios = DB::table('users')
            ->where('users.name','LIKE','%' . $valor . '%')
            ->Orwhere('users.lname','LIKE','%' . $valor . '%')
            ->Orwhere('users.lname2','LIKE','%' . $valor . '%')
            ->Orwhere('users.email','LIKE','%' . $valor . '%')
            ->orderBy('id', 'desc')
            ->paginate(50); 
        }

        return view("componentes.searchusers",compact('usuarios'));

    }

