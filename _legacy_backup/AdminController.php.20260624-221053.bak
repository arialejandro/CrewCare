                });
            }

            $subject = "TEST RESULT"." ".$producto->name;
        $data = [
            'nombre' => $producto->name,
        ];
        $for = $producto->email;
        Mail::send('correos.positive',$data, function($msj) use($subject,$for){
            $msj->from("noreply@crewcare.mx","CrewCare");
            $msj->subject($subject);
            $msj->to($for);
        });
        $prueba = prueba::create([
            'resultado' => 1
        ]);
        $pruebaform = usuariopcr::create([
            'id_usrio' => $producto->id,
            'id_prueba' => $prueba->id_prueba
        ]);
        
            $producto = User::findOrFail($id);
            $producto->enfermo = 1;
            $producto->resultpcr = 1;
            $producto->inline=0;
            $producto->tested=0;
            $producto->lastpcr = Carbon::now();
            $producto->update();
            
            return redirect('/listcrew');
        }
