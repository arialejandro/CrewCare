    public function acountupdate(Request $request, $id)
    {
        $user = User::find($id);
        $input = $request->except('password');
        if (! $request->filled('password')) {
            $user->fill($input)->save();
            return redirect('/usuarioscrud');
        }else{
            $user->password = Hash::make($request->password);
            $user->fill($input)->save();
            return redirect('/usuarioscrud'); 
        }
    
    }

