    public function testpcrcrud()
    {
        $diatest = DB::table('testqueue')->find(1);
        switch ($diatest->mainday) {
            
            case ("3"):
                $usuarios = DB::table('users')->where('activo','=',1)->where('tested','=',1)->where('resultpcr','=',0)->where('daytest','=',3)->orderBy('users.id', 'desc')->paginate(50);
                return view ('pcrtest/listcrew', compact('usuarios'));
                break;
            case ("2"):
                $usuarios = DB::table('users')->where('activo','=',1)->where('tested','=',1)->where('resultpcr','=',0)->where('daytest','=',2)->orderBy('users.id', 'desc')->paginate(50);
                return view ('pcrtest/listcrew', compact('usuarios'));
                break;
            default:
            $usuarios = DB::table('users')->where('activo','=',1)->where('tested','=',1)->where('resultpcr','=',0)->orderBy('users.id', 'desc')->paginate(50);
            return view ('pcrtest/listcrew', compact('usuarios'));
        }
    }

