# =============================================================================
# CrewCare — PLANTILLA de configuración. ESTE ARCHIVO SÍ SE VERSIONA.
#
# ⚠ AQUÍ NO VA NI UNA CREDENCIAL REAL. Sólo las claves con valores de ejemplo.
#
#   (2026-07-24) Este archivo TENÍA un juego completo de credenciales reales
#   —APP_KEY, DB_PASSWORD, MAIL_PASSWORD, MAIL_USERNAME y MAIL_HOST— DISTINTAS
#   de las de esta máquina, o sea de otro entorno, probablemente producción.
#   Se reemplazaron por placeholders. Esas credenciales deben darse por
#   QUEMADAS y cambiarse en el entorno del que salieron.
#
# Para levantar una instancia:
#   cp .env.example .env
#   php artisan key:generate
#   (luego llenar DB_*, MAIL_* y las claves propias del módulo de cédula)
# =============================================================================

# =============================================================================
# 🔴 IDENTIDAD DE LA PRODUCCIÓN — LLENAR ANTES DE INSTALAR EN PRODUCCIÓN
# -----------------------------------------------------------------------------
# El nombre y el código se SELLAN en cada documento y NO se pueden cambiar después
# (los documentos sellados no se borran). Si estas variables quedan sin definir, la
# instalación usa "Producción Demo" / "DEMO" — y con APP_ENV=production el seeder se
# NIEGA a correr (ProductionDemoSeeder lanza un error). Descomenta y pon los reales:
# INSTALL_PRODUCTION_NAME="Nombre real de la producción"
# INSTALL_PRODUCTION_CODE="COD"
# =============================================================================

APP_NAME=CrewCare
# 🔴 En el servidor real: production. Cambia además APP_DEBUG=false. Con `production`
# se activan la guarda del nombre de producción, HSTS y (si CREWCARE_CSP_ENFORCE=true) la CSP.
APP_ENV=local
# Se genera con `php artisan key:generate`. NUNCA se escribe a mano ni se comparte:
# firma las cookies de sesión y los magic links (URL firmadas con caducidad). Quien
# lo tenga puede FORJAR una URL firmada.
APP_KEY=
# Clave DEDICADA del sello digital (HMAC-SHA256 de los documentos sellados). Se genera
# con `php -r "echo 'base64:'.base64_encode(random_bytes(32));"`. Independiente de APP_KEY
# a propósito: se puede rotar sin invalidar sesiones, y rotar APP_KEY no tira los sellos.
# Si se deja vacía, el sello cae a APP_KEY (nunca a un hash sin clave). Ver config/crewcare.php.
CREWCARE_SEAL_KEY=
APP_DEBUG=true
# ⚠ SIEMPRE CON ESQUEMA (http:// o https://). Sin él, todo lo que se genere fuera de
# una petición —comandos de consola, colas reales— sale con la URL rota.
APP_URL=http://localhost
# ⏰ ZONA HORARIA DE LA PRODUCCIÓN. Es la hora que se IMPRIME en los documentos sellados
# (y no se puede corregir después: un sello no se rehace). Sin esta clave la app corre en
# UTC y un acta sellada a las 07:29 de CDMX dice "13:29". Ponla ANTES de sellar nada real.
# Valores: America/Mexico_City, America/Bogota, America/Santiago, Europe/Madrid…
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nombre_de_la_base
DB_USERNAME=usuario
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# ⚠ Mientras sea `sync`, el listener de alerta de riesgo Alto/Extremo corre dentro de la
# petición y sus enlaces salen bien. El día que se ponga una cola real (redis/database),
# ese correo pasa a depender de APP_URL.
QUEUE_CONNECTION=sync
# 🔴 database DESDE EL PRIMER DEPLOY. Permite revocar sesiones desde el perfil (requiere la tabla
# `sessions`, ya migrada). Si se activa DESPUÉS, invalida todas las sesiones vivas de golpe — por eso
# se pone de entrada, no más tarde. En local puede quedar en `file`.
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USERNAME=usuario@ejemplo.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# ⚠ ADDRESS con dos D. En el .env de esta máquina está escrito MAIL_FROM_ADRESS (con una
# sola), así que config/mail.php no lo encuentra y cae al valor por omisión.
MAIL_FROM_ADDRESS=noreply@crewcare.mx
MAIL_FROM_NAME="${APP_NAME}"

# --- Módulo de cédula profesional (SEP) --------------------------------------
# Correo del desarrollador para la telemetría técnica. Sin esta clave el módulo NO
# envía y NO truena: sólo deja aviso en el log.
TELEMETRY_EMAIL=
# Robot de verificación automática. Dejar en false hasta confirmar CEDULA_SEARCH_PATH y
# CEDULA_FIELD contra el PoC que funciona. Con false, el módulo va en manual.
CEDULA_AUTO_VERIFY=false
CEDULA_SOURCE_URL=
CEDULA_SEARCH_PATH=
CEDULA_FIELD=
CEDULA_TIMEOUT=10
CEDULA_RETRIES=1
CEDULA_USER_AGENT=

# --- Export PDF (Browsershot / Chrome headless) ------------------------------
# Rutas al binario de Chrome y a Node que usa Browsershot para rasterizar los
# documentos (app/Support/PdfExporter.php). En WINDOWS, si se omiten, usa las rutas
# por default de `C:\Program Files\...`. En LINUX (no-Windows) NO cae a rutas de
# Windows: autodetecta (/usr/bin/google-chrome, /usr/bin/node, `command -v`) y si no
# encuentra, FALLA diciendo qué falta — hay que definirlas. Verifícalas con `which
# google-chrome` / `which node`. De esto depende TODO el PDF por Chrome (DSR, H&S,
# PAE, WRAP, vehículos, contratos, scouting, ambulancia, medevac, mapa de riesgo).
BROWSERSHOT_CHROME=
BROWSERSHOT_NODE=

# --- Endurecimiento: CSP + sello de tiempo TSA -------------------------------
# CSP en BLOQUEO (true) o sólo REPORTE (false). Se enciende cuando el owner lo decide,
# tras confirmar que /csp-report no acusa violaciones. Ver config/crewcare.php.
CREWCARE_CSP_ENFORCE=false
# HSTS en producción sobre https (déjalo en true; SecurityHeaders ya gatea el entorno).
CREWCARE_HSTS=true
# Sello de tiempo RFC3161 sobre cada sello (best-effort, async vía cron `tsa:stamp`).
# enabled=true en prod; si la salida a Internet está cerrada, ponlo en false a conciencia.
CREWCARE_TSA_ENABLED=true
CREWCARE_TSA_TIMEOUT=8
CREWCARE_TSA_PRIMARY_NAME=DigiCert
CREWCARE_TSA_PRIMARY_URL=http://timestamp.digicert.com
CREWCARE_TSA_BACKUP_NAME=freeTSA
# ⚠ La URL de freeTSA lleva /tsr; el dominio a secas falla.
CREWCARE_TSA_BACKUP_URL=https://freetsa.org/tsr

# --- Bootstrap del primer super-admin (InstallAdminSeeder) -------------------
# Al correr `php artisan db:seed`, siembra el primer super-admin. Sin estas
# claves, inventa admin@<host> con una contraseña ALEATORIA impresa UNA sola vez.
# Definirlas para un alta determinista en el despliegue.
INSTALL_ADMIN_EMAIL=
INSTALL_ADMIN_NAME=
INSTALL_ADMIN_PASSWORD=

# --- Opcionales (sin uso hoy) ------------------------------------------------
GEMINI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
